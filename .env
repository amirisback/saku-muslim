# ============================================
# Common Environment Variables
# Shared across all environments (local & prod)
# ============================================

# --- App ---
NEXT_PUBLIC_APP_NAME="Saku Muslim"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- API ---
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_API_TIMEOUT=30000

# --- Features Flags ---
NEXT_PUBLIC_ENABLE_PWA=true

# --- SEO ---
NEXT_PUBLIC_SITE_TITLE="Saku Muslim — Aplikasi Ibadah Umat Muslim Terlengkap"
NEXT_PUBLIC_SITE_DESCRIPTION="Jadwal sholat akurat, Al-Qur'an 30 Juz dengan audio, arah kiblat, doa harian, 99 Asmaul Husna, kalkulator zakat, dan kalender hijriah."

# --- Locale ---
NEXT_PUBLIC_DEFAULT_LOCALE="id"

# --- Obfuscation (Sqids) ---
SQIDS_ALPHABET="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
